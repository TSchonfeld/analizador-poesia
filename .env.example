# Copiá este archivo como .env y completá UNA de las dos claves.
# Nunca subas .env al repositorio.

# Opción gratuita: API key de Gemini, creada en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opción paga: API key de Anthropic, creada en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: forzar el proveedor cuando hay dos claves («gemini» o «anthropic»).
# Si no se define, se usa Anthropic cuando su clave existe, y si no, Gemini.
# IA_PROVEEDOR=gemini

# Opcional: modelos usados para el análisis interpretativo.
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Sin ninguna clave, la app analiza la métrica, la versificación y los
# recursos formales que se detectan por reglas.
